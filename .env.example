NODE_ENV=development
PORT=4000
API_PREFIX=/api

DATABASE_URL=postgres://evoting:evoting_password@localhost:5432/evoting

CORS_ORIGIN=*
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# pow, pos, or pbft
CONSENSUS_ALGORITHM=pow
POW_DIFFICULTY=3
APP_VOTE_POW_DIFFICULTY=2
MINING_REWARD=10
MAX_TRANSACTIONS_PER_BLOCK=100

# Set true in containers if you want the API process to apply schema.sql at startup.
AUTO_MIGRATE=false
NEXT_PUBLIC_AUTH_BYPASS=false
JWT_SECRET=change-this-long-random-jwt-secret-before-production
CHAIN_SECRET=change-this-long-random-vote-signing-secret-before-production

# Hyperledger Fabric Gateway integration.
# Start with `npm run fabric:bootstrap && npm run fabric:up && npm run fabric:deploy`,
# then copy `npm run fabric:env` output.
FABRIC_ENABLED=false
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=evoting
FABRIC_CONTRACT_NAME=EVotingContract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=
FABRIC_CERT_PATH=
FABRIC_KEY_DIRECTORY=
FABRIC_VOTER_HASH_SALT=change-this-long-random-fabric-voter-hash-salt
